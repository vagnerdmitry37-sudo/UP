{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Options": {
    "Jwt": {
      "Issuer": "UP.Api",
      "Audience": "UP.Admin"
    },
    "Tokens": {
      "MaxConcurrentFamilies": 5,
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeMinutes": 180
    }
  }
}
