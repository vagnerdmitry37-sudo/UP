{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "UP.Api",
    "Audience": "UP.Admin"
  },
  "Auth": {
    "MaxConcurrentDevices": 5,
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeMinutes": 180
  }
}
